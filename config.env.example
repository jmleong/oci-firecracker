# Copy to config.env and fill in YOUR values. config.env is gitignored — never commit it.
# orchestrate/drive_oci.py loads this automatically.

# Region to run in.
OCI_REGION=us-ashburn-1

# The compartment to launch instances / create the VCN in (Console: Identity > Compartments).
OCI_COMPARTMENT=ocid1.compartment.oc1..REPLACE_WITH_YOUR_COMPARTMENT_OCID

# A region-specific Ubuntu 22.04 x86_64 image OCID (Console: Compute > Images, or the
# Marketplace/Platform image list). Must match OCI_REGION.
OCI_IMAGE=ocid1.image.oc1.<region>.REPLACE_WITH_UBUNTU_2204_IMAGE_OCID

# Availability-domain names, comma-separated, in preference order. The prefix is
# TENANCY-SPECIFIC (e.g. "abCD:US-ASHBURN-AD-1"); get yours from:
#   oci iam availability-domain list   (or the Console).
OCI_ADS=<yourprefix>:US-ASHBURN-AD-1,<yourprefix>:US-ASHBURN-AD-2,<yourprefix>:US-ASHBURN-AD-3

# CIDR(s) allowed to SSH into the benchmark hosts — the PUBLIC egress of wherever you
# run this driver. Comma-separated. Behind a proxy/VPN, allow your whole egress range.
# If unset, the driver defaults to 0.0.0.0/0 (open) and warns.
OCI_SSH_CIDR=your.public.egress.ip/32

# Optional VCN/subnet CIDRs (defaults shown).
# OCI_VCN_CIDR=10.10.0.0/16
# OCI_SUBNET_CIDR=10.10.1.0/24
